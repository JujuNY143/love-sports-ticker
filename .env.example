# HeyGen (https://docs.heygen.com) — required for src/pipeline/render.ts
HEYGEN_API_KEY=

# Optional: override HeyGen API base URL (useful for testing against a mock server)
HEYGEN_API_BASE=https://api.heygen.com

# Sports feed — ESPN's public scoreboard/news endpoints need no key.
# Comma-separated ESPN league slugs, e.g. "football/nfl,basketball/nba,baseball/mlb,hockey/nhl"
SPORTS_LEAGUES=football/nfl,basketball/nba,baseball/mlb,hockey/nhl

# When set to "1", src/feeds uses local fixtures instead of calling ESPN (for dev/CI without network).
USE_SAMPLE_FEED=0
